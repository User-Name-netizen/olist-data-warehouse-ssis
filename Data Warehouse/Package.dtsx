    order_id,
    customer_id,
    order_status,
    order_purchase_timestamp,

    -- Làm sạch: convert 1753-01-01 về NULL
    NULLIF(order_approved_at,             '17530101') AS order_approved_at,
    NULLIF(order_delivered_carrier_date,  '17530101') AS order_delivered_carrier_date,
    NULLIF(order_delivered_customer_date, '17530101') AS order_delivered_customer_date,
    order_estimated_delivery_date,

    -- Date keys (non-null)
    CAST(CONVERT(VARCHAR(8), order_purchase_timestamp, 112) AS INT)      AS purchase_date_key,
    CAST(CONVERT(VARCHAR(8), order_estimated_delivery_date, 112) AS INT) AS estimated_date_key,

    -- Date keys (nullable - đã clean)
    CAST(CONVERT(VARCHAR(8), NULLIF(order_approved_at,            '17530101'), 112) AS INT) AS approved_date_key,
    CAST(CONVERT(VARCHAR(8), NULLIF(order_delivered_carrier_date, '17530101'), 112) AS INT) AS carrier_date_key,
    CAST(CONVERT(VARCHAR(8), NULLIF(order_delivered_customer_date,'17530101'), 112) AS INT) AS delivery_date_key,

    -- Time calculations
    CAST(DATEDIFF(MINUTE, order_purchase_timestamp,
        NULLIF(order_approved_at,'17530101')) / 60.0 AS DECIMAL(10,2))            AS approval_hours,
    CAST(DATEDIFF(HOUR, order_purchase_timestamp,
        NULLIF(order_delivered_carrier_date,'17530101')) / 24.0 AS DECIMAL(10,2)) AS carrier_days,
    CAST(DATEDIFF(HOUR, order_purchase_timestamp,
        NULLIF(order_delivered_customer_date,'17530101')) / 24.0 AS DECIMAL(10,2)) AS delivery_days,

    DATEDIFF(DAY, order_purchase_timestamp, order_estimated_delivery_date) AS estimated_days,

    DATEDIFF(DAY,
        NULLIF(order_delivered_customer_date,'17530101'),
        order_estimated_delivery_date)                                     AS days_early_late,

    -- Flags
    CASE 
        WHEN NULLIF(order_delivered_customer_date,'17530101') IS NULL THEN 0
        WHEN order_delivered_customer_date &lt;= order_estimated_delivery_date THEN 1 
        ELSE 0 
    END AS is_on_time,

    CASE WHEN order_status = 'delivered' THEN 1 ELSE 0 END AS is_delivered,

    1 AS order_count

FROM Stage.STG_Orders</property>
