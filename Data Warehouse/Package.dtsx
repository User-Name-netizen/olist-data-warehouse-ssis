                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    oi.order_id,
    oi.order_item_id,
    oi.product_id,
    oi.seller_id,
    o.customer_id,

    -- Date key từ STG_Orders
    CAST(CONVERT(VARCHAR(8), o.order_purchase_timestamp, 112) AS INT) AS purchase_date_key,

    -- Measures
    oi.price,
    oi.freight_value,
    ISNULL(oi.price, 0) + ISNULL(oi.freight_value, 0) AS total_value,
    1 AS item_count

FROM Stage.STG_Order_Items oi
INNER JOIN Stage.STG_Orders o ON oi.order_id = o.order_id</property>
